# Copier ce fichier vers application.properties puis remplacer les valeurs factices.
spring.datasource.url=jdbc:mysql://localhost:3306/lias_db?useSSL=false&serverTimezone=UTC
spring.datasource.username=lias_user
spring.datasource.password=FAKE_DB_PASSWORD_CHANGE_ME

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
server.error.include-message=always

spring.mail.host=smtp.example.invalid
spring.mail.port=587
spring.mail.username=mailer@example.invalid
spring.mail.password=FAKE_SMTP_PASSWORD_CHANGE_ME
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

app.frontend.url=http://localhost:4200
app.jwt.secret=${JWT_SECRET:ZmFrZS1leGFtcGxlLWtleS1vbmx5LWRvLW5vdC11c2UtMzItYnl0ZXMh}

spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=6MB
app.upload.dir=uploads/photos
app.upload.private-dir=private-data/adhesions
